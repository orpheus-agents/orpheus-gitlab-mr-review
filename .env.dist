APP_MODE=dev
LOG_LEVEL=debug
HTTP_TIMEOUT_SECONDS=30
POLL_INTERVAL_SECONDS=30
SHUTDOWN_TIMEOUT_SECONDS=20
RUN_TIMEOUT_SECONDS=3600
HOOK_TIMEOUT_SECONDS=300
MAX_SESSION_REQUEST_BYTES=1048576
RECONCILE_WORKER_COUNT=4
RECONCILE_QUEUE_CAPACITY=128
MAX_CONCURRENT_REVIEWS=4

GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=

ORPHEUS_BASE_URL=https://orpheus.example.com
# Public Web UI URL; defaults to ORPHEUS_BASE_URL when empty.
ORPHEUS_WEB_BASE_URL=
ORPHEUS_API_KEY=

# Directory of Markdown workflow files; relative to the process working directory.
WORKFLOWS_DIR=workflows
